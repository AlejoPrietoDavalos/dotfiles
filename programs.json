{
  "arandr": {
    "packages": [
      { "manager": "pacman", "names": ["arandr"] },
      { "manager": "apt", "names": ["arandr"] }
    ],
    "deps": ["xorg"]
  },
  "bspwm": {
    "packages": [
      { "manager": "pacman", "names": ["bspwm", "xorg-setxkbmap", "feh"] },
      { "manager": "apt", "names": ["bspwm", "x11-xkb-utils", "feh"] }
    ],
    "files": { "src": "bspwm", "dst": "~/.config/bspwm" },
    "deps": ["arandr"]
  },
  "docker": {
    "packages": [
      { "manager": "pacman", "names": ["docker", "docker-compose"] },
      { "manager": "apt", "names": ["docker.io", "docker-compose"] }
    ],
    "hooks": { "post_install": ["docker_enable_service", "docker_configure_group"] }
  },
  "eww": {
    "provides": "bar",
    "bar": { "binary": "eww", "launch": "launch.sh", "stop": "stop.sh" },
    "packages": [
      { "manager": "yay", "names": ["eww", "libdbusmenu-gtk3", "gtk3", "gtk-layer-shell"] }
    ],
    "files": { "src": "eww", "dst": "~/.config/eww" },
    "deps": ["pulseaudio"]
  },
  "fonts": {
    "packages": [{ "manager": "pacman", "names": ["ttf-hack-nerd"] }],
    "files": { "src": "fonts", "dst": "~/.config/fonts" },
    "hooks": { "post_install": ["fonts_install_local"] }
  },
  "kitty": {
    "packages": [
      { "manager": "pacman", "names": ["kitty"] },
      { "manager": "apt", "names": ["kitty"] }
    ],
    "files": { "src": "kitty", "dst": "~/.config/kitty" }
  },
  "nvidia": {
    "packages": [{ "manager": "pacman", "names": ["nvidia-open", "nvidia-utils", "nvidia-settings", "nvidia-prime"] }]
  },
  "picom": {
    "packages": [
      { "manager": "pacman", "names": ["picom"] },
      { "manager": "apt", "names": ["picom"] }
    ],
    "files": { "src": "picom", "dst": "~/.config/picom" }
  },
  "playerctl": {
    "packages": [
      { "manager": "pacman", "names": ["playerctl"] },
      { "manager": "apt", "names": ["playerctl"] }
    ]
  },
  "polybar": {
    "provides": "bar",
    "bar": { "binary": "polybar", "launch": "launch.sh", "stop": "stop.sh" },
    "packages": [
      { "manager": "pacman", "names": ["polybar", "networkmanager", "libnotify"] },
      { "manager": "apt", "names": ["polybar", "network-manager", "libnotify-bin"] }
    ],
    "files": { "src": "polybar", "dst": "~/.config/polybar" },
    "deps": ["pulseaudio"]
  },
  "pulseaudio": {
    "packages": [
      { "manager": "pacman", "names": ["pamixer"] },
      { "manager": "apt", "names": ["pamixer"] }
    ]
  },
  "ranger": {
    "packages": [
      { "manager": "pacman", "names": ["ranger"] },
      { "manager": "apt", "names": ["ranger"] }
    ],
    "files": { "src": "ranger", "dst": "~/.config/ranger" }
  },
  "rofi": {
    "packages": [
      { "manager": "pacman", "names": ["rofi"] },
      { "manager": "apt", "names": ["rofi"] }
    ],
    "files": { "src": "rofi", "dst": "~/.config/rofi" }
  },
  "scrot": {
    "packages": [
      { "manager": "pacman", "names": ["scrot"] },
      { "manager": "apt", "names": ["scrot"] }
    ]
  },
  "starship": {
    "packages": [{ "manager": "pacman", "names": ["starship"] }],
    "files": { "src": "starship", "dst": "~/.config" }
  },
  "sxhkd": {
    "packages": [
      { "manager": "pacman", "names": ["sxhkd"] },
      { "manager": "apt", "names": ["sxhkd"] }
    ],
    "files": {
      "src": "sxhkd",
      "dst": "~/.config/sxhkd",
      "tokens": {
        "COMMAND_OPEN_BROWSER": "brave",
        "COMMAND_OPEN_INCOGNITO": "brave --incognito"
      }
    },
    "deps": ["playerctl", "scrot", "xclip"],
    "hooks": { "post_install": ["sxhkd_reload"] }
  },
  "thunar": {
    "packages": [
      { "manager": "pacman", "names": ["thunar"] },
      { "manager": "apt", "names": ["thunar"] }
    ],
    "files": { "src": "thunar", "dst": "~/.config/Thunar" }
  },
  "theme-dark": {
    "packages": [
      { "manager": "pacman", "names": ["xsettingsd", "qt5ct", "adwaita-icon-theme"] },
      { "manager": "apt", "names": ["xsettingsd", "qt5ct", "adwaita-icon-theme"] }
    ],
    "files": { "src": "theme", "dst": "~/.config" }
  },
  "vscode": {
    "packages": [{ "manager": "yay", "names": ["code"] }],
    "files": { "src": "vscode", "dst": "~/.config/Code/User" },
    "hooks": { "pre_install": ["vscode_render_settings"] }
  },
  "xclip": {
    "packages": [
      { "manager": "pacman", "names": ["xclip"] },
      { "manager": "apt", "names": ["xclip"] }
    ]
  },
  "xorg": {
    "packages": [
      { "manager": "pacman", "names": ["xorg-server", "xorg-xinit", "xorg-xrandr"] },
      { "manager": "apt", "names": ["xserver-xorg", "xinit", "x11-xserver-utils"] }
    ]
  }
}
