PROGRAMS = sorted(_PROGRAMS_RAW)

# Las barras (`provides: "bar"`) son alternativas EXCLUYENTES del mismo slot: no pueden
# convivir porque las dos reservan struts y bspwm restaría el espacio dos veces.
BAR_PROGRAMS = sorted(
    name for name, cfg in _PROGRAMS_RAW.items() if cfg.get("provides") == "bar"
)

# `install-core` instala UNA barra, no todas: cuál lo decide el estado de la máquina
# (~/.config/dotfiles/state.json), con fallback a polybar. Ver ManageBarService.
CORE_PROGRAMS_BASE = ["bspwm", "sxhkd", "picom"]


def build_bar_service():
    # El wiring vive en el factory, compartido con `scripts/launch_bar.py`: el CLI y el
    # arranque de sesión tienen que armar el MISMO grafo.
    from src.app.drivers.repositories.bar import build_manage_bar_service

    return build_manage_bar_service()


def core_programs() -> list[str]:
    """Los programas core, con la barra activa resuelta en runtime."""
    return [*CORE_PROGRAMS_BASE, build_bar_service().resolve().name]


def sh(*cmd: str, check: bool = True) -> int:
    return subprocess.run(list(cmd), check=check).returncode


def capture(*cmd: str) -> str:
    return subprocess.run(list(cmd), check=True, capture_output=True, text=True).stdout


def build_program_actions():
    from src.app.drivers.repositories.logs import ConfigureLoggingRepository
    from src.app.drivers.repositories.programs import (
        ProgramInstallerRepository,
        ProgramLoaderRepository,
    )
    from src.core.use_cases.program_actions import ProgramActions

    ConfigureLoggingRepository().configure(log_filename="main.log")
    return ProgramActions(
        program_loader_repo=ProgramLoaderRepository(),
        program_installer_repo=ProgramInstallerRepository(),
    )


# ---------------------------------------------------------------- programas

def cmd_program_action(args: argparse.Namespace) -> None:
    # Varios programas en una sola invocación: `dot install-files bspwm sxhkd`. Se instalan
    # en el orden dado, no en paralelo — algunos tienen hooks que asumen que el anterior ya
    # terminó (sxhkd_reload, por ejemplo).
    actions = build_program_actions()
    for program in args.program:
        actions.run(action=args.action, program=program)


def cmd_install_all(args: argparse.Namespace) -> None:
    build_program_actions().run(action="dirty_install_all_packages")


def cmd_install_core(args: argparse.Namespace) -> None:
    actions = build_program_actions()
    for program in core_programs():
        actions.run(action="install", program=program)


def cmd_remove_core(args: argparse.Namespace) -> None:
    if args.purge:
        os.environ["WM_REMOVE_PACKAGES"] = "1"
    actions = build_program_actions()
    for program in reversed(core_programs()):
        actions.run(action="uninstall", program=program)


