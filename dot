# ---------------------------------------------------------------- wifi

def _nmcli_lines(*cmd: str) -> list[list[str]]:
    """Corre nmcli en modo -t y devuelve filas ya separadas (maneja '\\:')."""
    out = capture("nmcli", "-t", *cmd)
    rows = []
    for line in out.splitlines():
        if not line.strip():
            continue
        fields = [f.replace("\\:", ":") for f in re.split(r"(?<!\\):", line)]
        rows.append(fields)
    return rows


def _saved_wifi_profiles() -> set[str]:
    return {
        name
        for name, ctype in _nmcli_lines("-f", "NAME,TYPE", "connection", "show")
        if ctype == "802-11-wireless"
    }


def _scan_networks() -> list[dict]:
    rows = _nmcli_lines("-f", "IN-USE,SSID,SECURITY,SIGNAL", "dev", "wifi", "list", "--rescan", "yes")
    seen: dict[str, dict] = {}
    for in_use, ssid, security, signal in rows:
        if not ssid:
            continue
        net = {
            "ssid": ssid,
            "in_use": in_use == "*",
            "secured": security not in ("", "--"),
            "signal": int(signal or 0),
        }
        # nmcli repite SSIDs (varios APs): nos quedamos con el de mejor señal.
        if ssid not in seen or net["signal"] > seen[ssid]["signal"]:
            net["in_use"] = net["in_use"] or seen.get(ssid, {}).get("in_use", False)
            seen[ssid] = net
        elif net["in_use"]:
            seen[ssid]["in_use"] = True
    return sorted(seen.values(), key=lambda n: n["signal"], reverse=True)


def cmd_wifi(args: argparse.Namespace) -> None:
    print("Escaneando redes...")
    networks = _scan_networks()
    if not networks:
        sys.exit("No se encontraron redes.")

    saved = _saved_wifi_profiles()
    for i, net in enumerate(networks, start=1):
        marks = ("*" if net["in_use"] else " ") + ("s" if net["ssid"] in saved else " ")
        lock = "🔒" if net["secured"] else "  "
        print(f"{i:>3}. [{marks}] {lock} {net['signal']:>3}%  {net['ssid']}")
    print("      (* conectada, s guardada)")

    choice = input("Red a conectar (número, enter cancela): ").strip()
    if not choice:
        return
    try:
        net = networks[int(choice) - 1]
    except (ValueError, IndexError):
        sys.exit("Opción inválida.")

    ssid = net["ssid"]
    if ssid in saved:
        sh("nmcli", "connection", "up", "id", ssid)
    elif net["secured"]:
        password = getpass.getpass(f"Clave de {ssid}: ")
        sh("nmcli", "dev", "wifi", "connect", ssid, "password", password)
    else:
        sh("nmcli", "dev", "wifi", "connect", ssid)
    print(f"Conectado a {ssid}. NetworkManager la recuerda para la próxima.")


