#!/bin/bash
pgrep -x sxhkd >/dev/null || sxhkd &

THEME_ENV_FILE="$HOME/.config/theme/theme-env.sh"
if [ -f "$THEME_ENV_FILE" ]; then
    . "$THEME_ENV_FILE"
fi

####################################################
#                   Config BSPWM                   #
####################################################
#---------------------------------------------------
#  - color window
#---------------------------------------------------
bspc config focused_border_color \#3F87A7
bspc config active_border_color   \#1F4D62

#---------------------------------------------------
#  - reglas de ventana
#---------------------------------------------------
# "Activate Linux" (widget de eww, ver `dot activate-linux`): flotante y en la capa de
# ABAJO, para que no tape ninguna aplicación ni ocupe lugar en el tiling.
#
# Por qué hace falta la regla y no alcanza con la config de eww: `stacking: "bg"` solo pide
# `_NET_WM_STATE_BELOW`, que es un HINT que el WM puede ignorar. Y con `windowtype "dock"`
# o "desktop" bspwm directamente no gestiona la ventana — queda donde X la mapeó, arriba de
# todo, y ninguna regla la alcanza. La ventana se declara `windowtype "normal"` para que
# bspwm SÍ la tome, y acá se la manda abajo. `layer=below` sí es una garantía.
#
# La clase es `Eww` con mayúscula (bspwm distingue mayúsculas al matchear).
bspc rule -a Eww state=floating layer=below border=off focus=off sticky=on

#---------------------------------------------------
#  - window propertys
#---------------------------------------------------
bspc config border_width         2
# OJO: esto NO reserva el lugar de la barra, aunque el nombre lo sugiera. Es solo un PISO.
#
# Medido: el _NET_WM_STRUT_PARTIAL de la barra SUBE el padding del monitor cuando se mapea
# (no se suma a este valor, lo pisa hacia arriba). Con `top_padding 3` y la barra pidiendo
# 32, `bspc query -T -m <monitor>` reporta `padding.top: 32`. Este 3 solo rige mientras la
# barra todavía no arrancó, o si algún día se corre bspwm sin barra.
#
# Quien manda sobre el espacio de la barra es su `:reserve` — ver
# `resources/config_files/eww/eww.yuck`, que además explica por qué el strut vale
# exactamente lo mismo que el alto de la barra.
bspc config top_padding          3
bspc config window_gap           0
bspc config split_ratio          0.5
bspc config borderless_monocle   true
bspc config gapless_monocle      true

DOTFILES_REPO="{{DOTFILES_REPO}}"

# Monitor -> desktops mapping (auto from active monitors)
if [ -f "$DOTFILES_REPO/scripts/apply_monitors.py" ]; then
    (
        cd "$DOTFILES_REPO" && \
        PYTHONPATH=. python3 ./scripts/apply_monitors.py
    )
fi

# Launch de la barra de estado ACTIVA (polybar o eww; ver `dot bar`).
#
# Esta línea es estable A PROPÓSITO y no vuelve a cambiar: el script resuelve cuál barra
# arrancar leyendo ~/.config/dotfiles/state.json. Antes apuntaba a
# `~/.config/polybar/launch.sh` directo, y cambiar de barra habría obligado a reinstalar
# la config de bspwm cada vez.
#
# Va DESPUÉS de apply_monitors.py, que es quien fija el orden de monitores y sus desktops:
# si la barra arrancara antes, sus ventanas irían al monitor equivocado.
if [ -f "$DOTFILES_REPO/scripts/launch_bar.py" ]; then
    (
        cd "$DOTFILES_REPO" && \
        PYTHONPATH=. python3 ./scripts/launch_bar.py
    ) &
fi

if [ -f "$DOTFILES_REPO/scripts/set_keyboard_layout.py" ]; then
    (
        cd "$DOTFILES_REPO" && \
        PYTHONPATH=. python3 ./scripts/set_keyboard_layout.py --layout latam
    )
fi

#----------picom----------
if command -v picom >/dev/null 2>&1; then
    pkill picom >/dev/null 2>&1 || true
    picom --config "$HOME/.config/picom/picom.conf" &
fi

if command -v xsettingsd >/dev/null 2>&1; then
    pkill xsettingsd >/dev/null 2>&1 || true
    xsettingsd -c "$HOME/.config/xsettingsd/xsettingsd.conf" &
fi

#----------Wallpaper Aleatorio----------
if [ -x "$DOTFILES_REPO/scripts/feh_random" ]; then
    "$DOTFILES_REPO/scripts/feh_random"
fi
